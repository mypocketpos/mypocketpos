rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function isStoreMember(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid));
    }

    // One email = one store
    match /email_index/{emailKey} {
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    // User -> store mapping
    match /user_store_index/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Platform admins
    match /platform_admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if isPlatformAdmin();
    }

    // Platform config
    match /platform_config/{docId} {
      allow read, write: if isPlatformAdmin();
    }

    // Stores
    match /stores/{storeId} {

      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid == request.auth.uid;

      allow get: if isStoreMember(storeId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();

      allow update: if isPlatformAdmin();

      // Store users
      match /users/{uid} {
        allow read: if isStoreMember(storeId) || isPlatformAdmin();

        allow create: if isSignedIn()
          && request.auth.uid == uid;

        allow update, delete: if isStoreMember(storeId);
      }

      // All other store data
      match /{document=**} {
        allow read, write: if isStoreMember(storeId);
      }
    }
  }
}