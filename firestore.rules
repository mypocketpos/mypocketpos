rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function isStoreMember(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid));
    }

    // Explicitly forces both sides to STRING to prevent Type Cast mismatch errors
    function isCustomerCartToken(storeId, cartId) {
      return isSignedIn()
        && request.auth.token.role == 'customer_cart'
        && request.auth.token.storeId == storeId
        && string(request.auth.token.cartId) == string(cartId);
    }

    match /stores/{storeId} {

      allow get: if isStoreMember(storeId) 
                 || isPlatformAdmin() 
                 || (isSignedIn() && request.auth.token.role == 'customer_cart');

      // PRODUCTS
      match /products/{productId} {
        allow read: if isStoreMember(storeId) 
                   || isPlatformAdmin() 
                   || (isSignedIn() && request.auth.token.role == 'customer_cart');
        allow write: if isStoreMember(storeId) || isPlatformAdmin();
      }

      // CARTS
      match /carts/{cartId} {
        allow read: if isStoreMember(storeId) 
                   || isPlatformAdmin() 
                   || isCustomerCartToken(storeId, cartId);

        allow create, update, delete: if isStoreMember(storeId) 
                                       || isCustomerCartToken(storeId, cartId);
      }

      // CART ITEMS (Where Customer Add/Remove was failing)
      match /cart_items/{itemId} {
        // Read items belonging to the customer's cart
        allow read: if isStoreMember(storeId) 
                   || isPlatformAdmin() 
                   || (isSignedIn() 
                       && request.auth.token.role == 'customer_cart' 
                       && string(request.auth.token.cartId) == string(resource.data.cartId));

        // Create item: verify incoming request payload's cartId matches token's cartId
        allow create: if isStoreMember(storeId) 
                       || (isSignedIn() 
                           && request.auth.token.role == 'customer_cart' 
                           && string(request.auth.token.storeId) == string(storeId)
                           && string(request.auth.token.cartId) == string(request.resource.data.cartId));

        // Update/Delete item: verify existing document's cartId matches token's cartId
        allow update, delete: if isStoreMember(storeId) 
                               || (isSignedIn() 
                                   && request.auth.token.role == 'customer_cart' 
                                   && string(request.auth.token.storeId) == string(storeId)
                                   && string(request.auth.token.cartId) == string(resource.data.cartId));
      }

      match /{document=**} {
        allow read, write: if isStoreMember(storeId) || isPlatformAdmin();
      }
    }
  }
}